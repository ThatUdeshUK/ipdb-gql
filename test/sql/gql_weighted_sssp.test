# name: test/sql/gql_weighted_sssp.test
# description: Weighted Dijkstra, aligned CSR projections, and cache invalidation
# group: [gql]

require duckgql

statement ok
COPY (SELECT * FROM (VALUES ('1','node;selected'), ('2','node;selected'),
('3','node;selected'), ('4','node;selected'), ('5','node'), ('6','node'))
v("id:ID", ":LABEL")) TO '__TEST_DIR__/weighted_nodes.csv' (HEADER, FORMAT CSV)

statement ok
COPY (SELECT * FROM (VALUES
('1','2','route',9.0,1), ('1','3','route',1.5,8), ('3','2','route',1.0,1),
('2','4','route',0.0,1), ('3','4','route',8.0,1), ('4','3','route',0.0,1),
('1','2','route',12.0,1), ('4','4','route',0.0,1), ('1','5','other',0.25,4))
e(":START_ID", ":END_ID", ":TYPE", "cost:double", "time:int"))
TO '__TEST_DIR__/weighted_edges.csv' (HEADER, FORMAT CSV)

statement ok
CREATE GRAPH weighted ANY

statement ok
COPY GRAPH weighted FROM (VERTICES '__TEST_DIR__/weighted_nodes.csv', EDGES '__TEST_DIR__/weighted_edges.csv') FORMAT GRAPH

statement ok
SESSION SET GRAPH weighted

# Cheaper indirect paths, fractional and zero weights, parallel edges, and cycles.
query IRIII
CALL algo.weighted_sssp('weighted', 1, 'cost')
----
1	0.000	NULL	NULL	0
5	0.250	1	9	1
3	1.500	1	2	2
2	2.500	3	3	3
4	2.500	2	4	4

statement ok
CREATE TEMP TABLE weight_builds AS SELECT build_count, memory_bytes FROM gql_csr_stats('weighted', weight_property := 'cost')

query I
SELECT count(*) FROM system.algo.weighted_sssp('weighted', 1, 'COST')
----
5

query I weighted_reader
SELECT count(*) FROM system.algo.weighted_sssp('weighted', 1, 'cost')
----
5

query I
SELECT s.build_count = b.build_count FROM gql_csr_stats('weighted', weight_property := 'cost') s, weight_builds b
----
true

# A different property has a separate cache entry and different distances.
query IR rowsort
SELECT vertex_id, distance FROM system.algo.weighted_sssp('weighted', 1, 'time')
----
1	0.000
2	1.000
3	3.000
4	2.000
5	4.000

query I
SELECT s.build_count = b.build_count + 1 FROM gql_csr_stats('weighted', weight_property := 'time') s, weight_builds b
----
true

query I
SELECT count(*) FROM system.algo.weighted_sssp('weighted', 1, 'cost')
----
5

query I
SELECT s.build_count = b.build_count + 1 FROM gql_csr_stats('weighted', weight_property := 'cost') s, weight_builds b
----
true

# Building unweighted/full topology must not evict weighted projections.
statement ok
CALL gql_build_csr('weighted')

query I
SELECT count(*) FROM system.algo.weighted_sssp('weighted', 1, 'cost')
----
5

query I
SELECT s.build_count = b.build_count + 2 FROM gql_csr_stats('weighted', weight_property := 'cost') s, weight_builds b
----
true

# SQL and GQL projections, target termination, and matched sources.
query IR
CALL algo.weighted_sssp('weighted', 1, 'cost', target_vertex_id := 3)
YIELD vertex_id, distance RETURN vertex_id, distance
----
1	0.000
5	0.250
3	1.500

query IR
MATCH (seed:node) WHERE seed.id = '1'
CALL algo.weighted_sssp('weighted', element_id(seed), 'cost', 'selected', 'route', 4)
YIELD vertex_id, distance RETURN vertex_id, distance
----
1	0.000
3	1.500
2	2.500
4	2.500

query IR
SELECT vertex_id, distance FROM system.algo.weighted_sssp('weighted', 6, 'cost')
----
6	0.000

query I
SELECT count(*) FROM system.algo.weighted_sssp('weighted', 1, 'cost', target_vertex_id := 6)
----
5

query IR rowsort
SELECT vertex_id, distance FROM system.algo.weighted_sssp('weighted', 4, 'cost', direction := 'in')
----
1	2.500
2	0.000
3	1.000
4	0.000

query IR rowsort
SELECT vertex_id, distance FROM system.algo.weighted_sssp('weighted', 4, 'cost', direction := 'both')
----
1	1.500
2	0.000
3	0.000
4	0.000
5	1.750

